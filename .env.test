NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_PROJECT_ID=demo-two-homes
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-two-homes
EMAIL_TRANSPORT=outbox

# Test-only values. Not secrets: they exist so env.ts validates under Vitest and E2E.
APP_URL=http://localhost:3100
NEXT_PUBLIC_APP_URL=http://localhost:3100
JOB_SECRET=test-job-secret-0123456789abcdef0123456789
LINK_SESSION_SECRET=test-link-session-secret-0123456789abcdef
OTP_PEPPER=test-otp-pepper-0123456789abcdef0123456789
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-two-homes.firebaseapp.com
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:demo
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
PAYPAL_ENV=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=test-paypal-client-id
NEXT_PUBLIC_PAYPAL_CLIENT_ID=test-paypal-client-id
PAYPAL_CLIENT_SECRET=test-paypal-client-secret
PAYPAL_CONNECT_RETURN_URL=http://localhost:3100/connect/paypal/callback
EMAIL_FROM="Two Homes Preflight <notifications@mail.huzaifalabs.site>"
