{
  "name": "two-homes-preflight",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "firebase emulators:exec --only firestore,auth --project demo-two-homes \"vitest run --project integration\"",
    "test:e2e": "playwright test",
    "firebase:deploy-rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "seed": "tsx --env-file=.env.local --conditions=react-server scripts/seed-demo.ts",
    "reset": "tsx --env-file=.env.local --conditions=react-server scripts/reset-demo.ts",
    "invariants": "tsx --env-file=.env.local --conditions=react-server scripts/check-invariants.ts",
    "ai:check-extraction": "tsx --env-file=.env.local --conditions=react-server scripts/check-extraction.ts",
    "paypal:setup-plans": "tsx --env-file=.env.local --conditions=react-server scripts/setup-paypal-plans.ts",
    "test:e2e:build": "node scripts/e2e-server.mjs --build-only"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@google/genai": "2.32.0",
    "@paypal/paypal-server-sdk": "2.5.0",
    "@paypal/react-paypal-js": "10.6.1",
    "ag-grid-community": "36.3.0",
    "ag-grid-react": "36.3.0",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "2.11.0",
    "cn": "^0.5.2",
    "firebase": "13.2.0",
    "firebase-admin": "14.5.0",
    "geist": "1.9.2",
    "lucide-react": "^1.70.0",
    "motion": "14.10.1",
    "next": "16.4.5",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.37.0",
    "server-only": "0.0.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "unpdf": "2.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "firebase-tools": "15.35.0",
    "msw": "3.0.4",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
